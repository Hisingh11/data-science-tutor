# Get a key from https://console.groq.com
GROQ_API_KEY=

# Optional model overrides for Groq
# GROQ_REASONING_MODEL=openai/gpt-oss-120b
# GROQ_FAST_MODEL=openai/gpt-oss-20b
# GROQ_CODE_MODEL=openai/gpt-oss-120b
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# GROQ_MODERATION_MODEL=openai/gpt-oss-120b

# OpenAI-compatible provider (DeepSeek, OpenRouter, etc.)
# OPENAI_COMPAT_API_KEY=sk-...
# OPENAI_COMPAT_BASE_URL=https://api.deepseek.com/v1  # or https://openrouter.ai/api/v1
# OPENAI_COMPAT_MODEL=deepseek-chat                    # main model for reasoning
# OPENAI_COMPAT_FAST_MODEL=deepseek-chat               # fast model for grading
# OPENAI_COMPAT_CODE_MODEL=deepseek-coder              # code model

# Self-RAG: also search the web on every tutor question (slower)
# SELF_RAG_WEB=1

# Evals: use a different model as LLM-as-judge
# EVAL_JUDGE_MODEL=openai/gpt-oss-120b
